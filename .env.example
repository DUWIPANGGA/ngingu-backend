APP_NAME="Ngingu"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ngingu
DB_USERNAME=ngingu_user
DB_PASSWORD=your_strong_password_here

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.your-mail-provider.com
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM_ADDRESS="noreply@ngingu.id"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (S3 / MinIO) — gambar scan & media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

# ML Service (Python FastAPI) — server-to-server, API.md §10
# driver: fake (development/test, tanpa Python) | http (produksi)
ML_DRIVER=fake
# Port 8009 — 8000 dipakai backend (run_dev.ps1). Lihat ml-service/README.md.
ML_BASE_URL=http://127.0.0.1:8009
ML_TIMEOUT=30
ML_CONNECT_TIMEOUT=5
ML_GRADCAM=true

# Long-polling GET /api/scans/{id}?wait= (API.md §4.3, §9.1)
SCAN_WAIT_DEFAULT=120
SCAN_WAIT_MAX=300
SCAN_POLL_INTERVAL_MS=1000
LOW_CONFIDENCE_THRESHOLD=60

# Upload gambar (API.md §2.7)
# Disk untuk foto scan/GradCAM/avatar — harus bisa diserve publik (public|s3).
# `local` dipakai khusus untuk model/dataset ML (private, butuh signature).
UPLOAD_DISK=public
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_IMAGES_PER_SCAN=5
UPLOAD_MAX_IMAGES_PER_POST=5
UPLOAD_MAX_IMAGES_PER_COMMENT=3
UPLOAD_COMPRESS_TARGET_KB=500

# ---------------------------------------------------------------------------
# CATATAN TIMEOUT SERVER (WAJIB untuk long-polling 300 detik)
#   php-fpm:  max_execution_time = 0 (atau >= 310), request_terminate_timeout >= 310s
#   nginx:    fastcgi_read_timeout / proxy_read_timeout >= 310s
#   Flutter:  Dio connectTimeout/receiveTimeout >= 320000 ms
# ---------------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"
SANCTUM_EXPIRATION=43200

# ---------------------------------------------------------------------------
# LOGIN GOOGLE (Socialite, token flow — tanpa redirect)
#   GOOGLE_CLIENT_ID dipakai untuk validasi claim aud id_token; kosongkan
#   untuk menonaktifkan validasi (tidak disarankan di produksi).
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
